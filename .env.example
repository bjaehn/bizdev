# Secrets and model name come from the environment only (never config.yaml).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional. If unset, `bd card` is a dry run and never posts.
TEAMS_WEBHOOK_URL=
# Optional overrides
BD_CONFIG=config.yaml
BD_DB_PATH=bd.sqlite
# Sent as User-Agent when verifying source URLs and calling SEC EDGAR. The SEC requires your company
# name and a contact email, e.g. "SEI BD Research ops@yourcompany.com". The edgar scanner and CIK
# confirmation in `bd enrich` are disabled until this is set.
BD_USER_AGENT=
ANTHROPIC_WORKSPACE_ID=   # only if your API key is not scoped to a workspace (the API then asks for this header)
